{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartnews-spa",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  // No directory: the Vite plugin owns it. No run_worker_first: assets must be
  // served without invoking the Worker, or the migration saves nothing.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smartnews",
      "database_id": "1e779125-88d9-4688-85f2-08c3c6bcecf3"
    }
  ]
}
