{
  "name": "smartnews",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ingest": "bun scripts/pipeline/ingest.ts",
    "pipeline": "bun scripts/pipeline/run.ts",
    "pipeline:local": "LLM_PROVIDER=openai LLM_BASE_URL=http://localhost:1234/v1 LLM_MODEL=ornith-1.5-9b-mlx LLM_API_KEY=lm-studio LLM_CONCURRENCY=4 LLM_JSON_MODE=text bun scripts/pipeline/run.ts",
    "build:check": "tsc --noEmit && tsc -p deploy/cron-worker && bun scripts/d1/check.ts",
    "cycle": "bun scripts/pipeline/cycle.ts",
    "cycle:local": "LLM_PROVIDER=openai LLM_BASE_URL=http://localhost:1234/v1 LLM_MODEL=ornith-1.5-9b-mlx LLM_API_KEY=lm-studio LLM_CONCURRENCY=4 LLM_JSON_MODE=text bun scripts/pipeline/cycle.ts",
    "places": "bun scripts/places/build.ts",
    "places:emit": "bun scripts/places/emit.ts",
    "sync": "bun scripts/d1/sync.ts",
    "migrate:d1": "bun scripts/d1/migrate.ts",
    "usage": "bun scripts/usage.ts",
    "deploy": "bun run migrate:d1 && cd web && bun run deploy",
    "hydrate": "bun scripts/d1/hydrate.ts",
    "seed:local-d1": "bun scripts/d1/seed-local.ts",
    "checkpoint": "bun scripts/pipeline/checkpoint.ts"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "p-limit": "^7.3.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/node": "^26.5.1",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260903.1": true
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "iOS >= 16",
    "Android >= 10"
  ]
}
