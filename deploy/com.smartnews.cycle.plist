<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>              <string>com.smartnews.cycle</string>
  <key>WorkingDirectory</key>   <string>__PROJECT_DIR__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NPM__</string>
    <string>run</string>
    <string>cycle</string>
  </array>
  <key>StartInterval</key>      <integer>900</integer>
  <key>RunAtLoad</key>          <true/>
  <key>StandardOutPath</key>    <string>__PROJECT_DIR__/data/cycle.log</string>
  <key>StandardErrorPath</key>  <string>__PROJECT_DIR__/data/cycle.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__PATH__</string>
  </dict>
</dict>
</plist>
