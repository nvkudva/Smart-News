# Which model writes the summaries.
#   gemini   (default) — Google AI Studio
#   deepseek           — api.deepseek.com, OpenAI-compatible
#   openai             — OpenAI, or ANY OpenAI-compatible server via LLM_BASE_URL
LLM_PROVIDER=gemini

# Optional overrides. Each provider has a working default.
# LLM_MODEL=gemini-3.8-flash
# LLM_BASE_URL=https://openrouter.ai/api/v1     # provider=openai + any compatible host
# LLM_RPM=8                                     # requests/minute to pace at

# Key for the chosen provider. LLM_API_KEY overrides all of these.
GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# LLM_API_KEY=

# --- free, local, uncapped: LM Studio / Ollama / llama.cpp ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=ornith-1.5-9b-mlx
# LLM_RPM=600
# LLM_CONCURRENCY=2
