{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "smartnews",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "smartnews-local-d1",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:local"
      ],
      "port": 3000
    },
    {
      "name": "smartnews-prod-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "SMARTNEWS_LOCAL_D1=1 npx next start -H 0.0.0.0 -p 3000"
      ],
      "port": 3000
    }
  ]
}
